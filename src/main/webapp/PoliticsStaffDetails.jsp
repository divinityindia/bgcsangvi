				<div class="row" style="margin-top: 2%;">
					<div id="tg-twocolumns" class="tg-twocolumns">
						<div class="col-xs-12 col-sm-4 col-md-3 col-lg-3">
							<aside id="tg-sidebar" class="tg-sidebar">
								<div class="tg-widget tg-widgetaboutusnav">
									
									<div class="tg-widgetcontent" style="width:100% ;height: 500px;padding-top: 60px; ">
									<hr style="border: 1px solid black;">
										<ul class="listul" >
											<a href="GetDeptDtl?did=8&pgnm=Politics" ><li class="des">About Department</li></a>
											<a href="GetDepWiseEmp?did=8&pgnm=PoliticsStaffDetails"><li  class="active des">Staff Details</li></a>
											<a href="GetDepWiseEvent?did=8&pgnm=PoliticsEventandPhotos"><li class="des">Events & Photos</li></a>
											<a href="GetDepWiseStaffRes?did=8&pgnm=PoliticsResearch"><li class="des">Research</li></a>
											<a href="GetDepWiseCourseStruct?did=8&pgnm=PoliticsCourseStructure"><li class="des">Course Structure</li></a>
											<a href="GetDepWiseDepResult?did=8&pgnm=PoliticsResult"><li class="des">Result</li></a>
										</ul>
									</div>
								</div>
							</aside>
						</div>
						<div class="col-xs-12 col-sm-8 col-md-9 col-lg-9">
						<div class="table-responsive">
						<h2 class="title_contanier" >Department Staff Details</h2>
						  <hr style="border: 1px solid;">
						<div id="container1">
						  <div id="container2" >
						     <c:forEach var="dtl" items="${cat}" >
						         <table style="width: 100%;">
						                <tr style="background-color: #00808033;">
						                    <td width="30%">
						                        <img style="width: 100px; height: 100px; padding: 2px;" src="${s3pat}emp/${dtl.EID}/photo/${dtl.photo}"/>
						                    
						                    </td>
						                    <td width="70%;" style="text-align: left;">
						                        <b> Name :-</b><b style="color: blue;">${dtl.sal} ${dtl.fname} ${dtl.mname} ${dtl.lname}</b><br>
												<b> Designation:-</b> ${dtl.designame} <br>
											    <b> Qualification:-</b>${dtl.quali}<br> 
											    <b>Email ID:-</b>${dtl.mail}<br> 
											    <b>Contact No.:-</b>${dtl.contact1} <br>
						                    </td>
						                </tr>
						                  <tr style="background-color: #428bca33;">
						                    <td colspan="2">
						                     <div class="row">
						                     <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2">
											  <b>Experience in Years:</b>
												</div>
												<div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
													${dtl.texp}Years 
												</div>
												<div class="col-xs-12 col-sm-2 col-md-2 col-lg-2">
												<b>Expert Area:</b>
												</div>
												<div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
													${dtl.aoi}
												</div>
						                       
						                    </div>
						                   <div class="row">
										
												<div class="col-xs-12 col-sm-2 col-md-2 col-lg-2">
													<b>Academic Profile:</b>
												</div>'
												<div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
													<a href="${s3pat}emp/${dtl.EID}/resume/${dtl.resume}" target="_blank" >${dtl.resume}</a>
												</div>
										 </div>
						                    </td>
						                 </tr>
						         </table>
						         <br>
